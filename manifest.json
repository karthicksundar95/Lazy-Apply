{
  "manifest_version": 3,
  "name": "AI Prompt Processor Pro",
  "version": "2.0.0",
  "description": "Professional AI text processing with OpenAI and Gemini - Full-featured interface",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Prompt Processor Pro"
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg", 
    "128": "icons/icon.svg"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}